:1,"message":"151","line":221,"column":13,"nodeType":"152","endLine":221,"endColumn":123},{"ruleId":"150","severity":1,"message":"151","line":224,"column":13,"nodeType":"152","endLine":224,"endColumn":122},{"ruleId":"150","severity":1,"message":"151","line":227,"column":13,"nodeType":"152","endLine":231,"endColumn":15},{"ruleId":"150","severity":1,"message":"151","line":234,"column":13,"nodeType":"152","endLine":238,"endColumn":15},"@next/next/no-img-element","Using `<img>` could result in slower LCP and higher bandwidth. Use `<Image />` from `next/image` instead to utilize Image Optimization. See: https://nextjs.org/docs/messages/no-img-element","JSXOpeningElement","jsx-a11y/alt-text","img elements must have an alt prop, either with meaningful text, or an empty string for decorative images.","import/no-anonymous-default-export","Assign array to a variable before exporting as module default","ExportDefaultDeclaration"]
-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z\"\n            clipRule=\"evenodd\"\n            />\n        </svg>\n        ),\n    },\n    {\n        name: 'Dribbble',\n        href: '#',\n        icon: (props:any) => (\n        <svg fill=\"currentColor\" viewBox=\"0 0 24 24\" {...props}>\n            <path\n            fillRule=\"evenodd\"\n            d=\"M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10c5.51 0 10-4.48 10-10S17.51 2 12 2zm6.605 4.61a8.502 8.502 0 011.93 5.314c-.281-.054-3.101-.629-5.943-.271-.065-.141-.12-.293-.184-.445a25.416 25.416 0 00-.564-1.236c3.145-1.28 4.577-3.124 4.761-3.362zM12 3.475c2.17 0 4.154.813 5.662 2.148-.152.216-1.443 1.941-4.48 3.08-1.399-2.57-2.95-4.675-3.189-5A8.687 8.687 0 0112 3.475zm-3.633.803a53.896 53.896 0 013.167 4.935c-3.992 1.063-7.517 1.04-7.896 1.04a8.581 8.581 0 014.729-5.975zM3.453 12.01v-.26c.37.01 4.512.065 8.775-1.215.25.477.477.965.694 1.453-.109.033-.228.065-.336.098-4.404 1.42-6.747 5.303-6.942 5.629a8.522 8.522 0 01-2.19-5.705zM12 20.547a8.482 8.482 0 01-5.239-1.8c.152-.315 1.888-3.656 6.703-5.337.022-.01.033-.01.054-.022a35.318 35.318 0 011.823 6.475 8.4 8.4 0 01-3.341.684zm4.761-1.465c-.086-.52-.542-3.015-1.659-6.084 2.679-.423 5.022.271 5.314.369a8.468 8.468 0 01-3.655 5.715z\"\n            clipRule=\"evenodd\"\n            />\n        </svg>\n        ),\n    },\n    ],\n}\n\n\n\n\n            {/* Home Page\n\n            Have a tweet that is editable and downlodable\n\n            have a 'to have more settings go to editor' - this is to show the prodct and let them use it on page 1 */}\n\nexport default function Home() {\n    return (\n        <>\n\n        <Head>\n            <title>Create Next App</title>\n            <meta name=\"description\" content=\"Generated by create next app\" />\n            <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n            <link rel=\"icon\" href=\"/favicon.ico\" />\n        </Head>\n        <main className=\"\">\n\n\n            <div className=\"relative overflow-hidden bg-gray-800\">\n            <div className=\"relative pt-6 pb-16 sm:pb-24\">\n\n                <nav className=\"relative mx-auto flex items-center justify-between  sm:px-6 md:px-16\" aria-label=\"Global\">\n                    <div className=\"flex flex-1 items-center\">\n                        <div className=\"flex w-full items-center justify-between md:w-auto\">\n                            <a href=\"#\">\n                                <span className=\"sr-only\">TweetCrafter</span>\n                                <h1 className=\"font-bold text-2xl text-white\">TweetCrafter</h1>\n                            </a>\n                        </div>\n                    </div>\n\n                    <div className=\"hidden md:flex\">\n                    <div className=\"hidden space-x-10 md:ml-10 md:flex\">\n                        {navigation.map((item) => (\n                        <a key={item.name} href={item.href} className=\"font-medium text-white hover:text-gray-300\">\n                            {item.name}\n                        </a>\n                        ))}\n                    </div>\n                    </div>\n                </nav>\n            \n\n                <div className=\"flex justify-between mt-16 px-16\">\n\n                    <div className=\"sm:text-center md:max-w-2xl lg:flex lg:items-center lg:text-left\">\n                    <div>\n                \n                        <div className=\"mb-6\">\n                            <h1 className=\"mt-4 text-4xl font-bold tracking-tight text-white sm:text-5xl md:text-7xl\">\n                                Become a master of deception with our fake <span className=\"text-blue-400\">tweet</span> crafter!\n                            </h1>\n                            \n                            <p className=\"mt-3 text-base text-gray-300 sm:mt-5 sm:text-xl lg:text-lg xl:text-xl\">\n                                Create a fake tweet, profile, anything you like for tweeter, and download it as image. Its easy as clicking what you want to edit, and downloading it. Give it a try on the right and download the image!\n                            </p>\n                        </div>\n                             \n                        <div className=\"flex space-x-4\">\n                            <button className=\"items-center justify-center rounded-md border border-transparent bg-indigo-600 px-8 py-3 text-base font-medium text-white hover:bg-indigo-700 md:py-4 md:px-10 md:text-lg\">\n                                Go Editor\n                            </button>\n                            <button className=\"items-center justify-center rounded-md border border-transparent bg-indigo-600 px-8 py-3 text-base font-medium text-white hover:bg-indigo-700 md:py-4 md:px-10 md:text-lg\">\n                                Download Image \n                            </button>\n                        </div>\n\n                    </div>\n                    </div>\n\n                    <div className=\"mt-16 sm:mt-24 lg:mt-0\">\n                        {/* <div className=\"shadow-2xl\"> */}\n                        <div className=\"overflow-hidden rounded-2xl\">\n                            \n                            <Tweet data={publicProfile} />            \n                            {/* </div> */}\n                        </div>\n                    </div>\n\n                </div>\n\n\n             </div>\n            </div>\n\n\n                            \n\n    \n    <div className=\"bg-white\">\n      <div className=\"mx-auto max-w-7xl py-12 px-4 sm:px-6 lg:py-16 lg:px-8\">\n        <p className=\"text-center text-lg font-semibold text-gray-600\">\n          Trusted by over 100+ BIGGEST <img className=\"inline-block h-4\" src=\"https://emojipedia-us.s3.dualstack.us-west-1.amazonaws.com/thumbs/120/twitter/322/flag-united-states_1f1fa-1f1f8.png\" /> and BEST companies... \n          or so do we claim\n          {/* or at least that's what we tell ourselves */}\n        </p>\n        <div className=\"mt-6 grid grid-cols-2 gap-0.5 md:grid-cols-3 lg:mt-8\">\n\n          <div className=\"col-span-1 flex justify-center items-center bg-gray-50 py-8 px-8\">\n            <img className=\"max-h-10\" src=\"https://upload.wikimedia.org/wikipedia/commons/thumb/7/7b/Meta_Platforms_Inc._logo.svg/1280px-Meta_Platforms_Inc._logo.svg.png\" alt=\"Workcation\" />\n          </div>\n\n          <div className=\"col-span-1 flex justify-center items-center bg-gray-50 py-8 px-8\">\n            <img className=\"max-h-20\" src=\"https://i.ebayimg.com/images/g/bfUAAOSw88RbDbfe/s-l1600.jpg\" alt=\"Mirage\" />\n          </div>\n          <div className=\"col-span-1 flex justify-center items-center bg-gray-50 py-8 px-8\">\n            <img className=\"max-h-16\" src=\"https://assets.stickpng.com/images/580b57fcd9996e24bc43c51f.png\" alt=\"Tuple\" />\n          </div>\n          <div className=\"col-span-1 flex justify-center items-center bg-gray-50 py-8 px-8\">\n            <img className=\"max-h-12\" src=\"https://cdn.mos.cms.futurecdn.net/6bTF6C2QiWXvhi33fJi3AC.jpg\" alt=\"Laravel\" />\n          </div>\n          <div className=\"col-span-1 flex justify-center items-center bg-gray-50 py-8 px-8\">\n            <img\n              className=\"max-h-12\"\n              src=\"https://upload.wikimedia.org/wikipedia/commons/thumb/0/08/Netflix_2015_logo.svg/2560px-Netflix_2015_logo.svg.png\"\n              alt=\"StaticKit\"\n            />\n          </div>\n          <div className=\"col-span-1 flex justify-center items-center bg-gray-50 py-8 px-8\">\n            <img\n              className=\"max-h-12\"\n              src=\"https://storage.googleapis.com/pr-newsroom-wp/1/2018/11/Spotify_Logo_CMYK_Green.png\"\n              alt=\"Statamic\"\n            />\n          </div>\n        </div>\n      </div>\n    </div>\n\n\n\n\n\n\n            <footer className=\"bg-white\">\n            <div className=\"mx-auto max-w-7xl overflow-hidden py-12 px-4 sm:px-6 lg:px-8\">\n\n                <nav className=\"-mx-5 -my-2 flex flex-wrap justify-center\" aria-label=\"Footer\">\n                {footerNavigation.main.map((item) => (\n                    <div key={item.name} className=\"px-5 py-2\">\n                    <a href={item.href} className=\"text-base text-gray-500 hover:text-gray-900\">\n                        {item.name}\n                    </a>\n                    </div>\n                ))}\n                </nav>\n\n                <div className=\"mt-8 flex justify-center space-x-6\">\n                {footerNavigation.social.map((item) => (\n                    <a key={item.name} href={item.href} className=\"text-gray-400 hover:text-gray-500\">\n                    <span className=\"sr-only\">{item.name}</span>\n                    <item.icon className=\"h-6 w-6\" aria-hidden=\"true\" />\n                    </a>\n                ))}\n                </div>\n\n                <p className=\"mt-8 text-center text-base text-gray-400\">&copy; 2023 TweetCrafter, Inc. All rights reserved.</p>\n            </div>\n            </footer>\n\n\n        </main>\n        </>\n    )\n}\n","C:\\Users\\aurel\\Desktop\\WebDev\\tweetcrafter.com\\src\\pages\\_app.tsx",[],[],"C:\\Users\\aurel\\Desktop\\WebDev\\tweetcrafter.com\\src\\pages\\_document.tsx",[],[],"C:\\Users\\aurel\\Desktop\\WebDev\
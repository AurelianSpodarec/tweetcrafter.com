e) \r\n    return (\r\n        <div>\r\n            <div className=\"p-4 text-center\">\r\n            <img className=\"rounded-xl\" src={option.thumbnail} />\r\n            <h3 className=\"text-gray-300\">{option.name} <br/>(Coming Soon)</h3>\r\n        </div>\r\n        </div>\r\n    )\r\n    return (\r\n        <div className=\"p-4 text-center\" onClick={() => setActiveTab(option.id)}>\r\n            <img className=\"rounded-xl\" src={option.thumbnail} />\r\n            <h3 className=\"text-gray-300\">{option.name}</h3>\r\n        </div>\r\n    )\r\n}\r\n\r\nfunction OptionView() {\r\n    return (\r\n        <>\r\n            {options.map((option) => {\r\n                return <Option key={option.id} data={option} />\r\n            })}\r\n        </>\r\n    )\r\n}\r\n\r\nexport default OptionView;","C:\\Users\\aurel\\Desktop\\WebDev\\tweetcrafter.com\\src\\pages\\editor\\_components\\Settings\\SettingView.tsx",[],[],"C:\\Users\\aurel\\Desktop\\WebDev\\tweetcrafter.com\\src\\pages\\index.tsx",["142","143","144","145","146","147","148","149"],[],"import Head from 'next/head'\nimport Image from 'next/image' \nimport Tweet from '../components/templates/Tweet';\nimport profiles from './../json/profiles';\n\n\nconst publicProfile = {\n    \"id\": 2,\n    \"name\": \"ElonMusk\",\n    \"screen_name\": \"ElonMusk\",\n    \"handler\": \"ElonMusk\",\n    \"verified\": \"person\",\n    \"location\": null,\n    \"url\": null,\n    \"type\": \"person\",\n    \"followers_count\": 232,\n    \"friends_count\": 2,\n    \"listed_count\": 44,\n    \"favourites_count\": 6,\n    \"statuses_count\": 85,\n    \"created_at\": \"Mon Nov 29 21:18:15 +0000 2010\",\n    \"profile_banner_url\": \"https://pbs.twimg.com/profile_banners/44196397/1576183471/1080x360\",\n    \"profile_image_url\": \"https://pbs.twimg.com/profile_images/1590968738358079488/IY9Gx6Ok_400x400.jpg\",\n    \"tweetSrc\": \"https://i.imgflip.com/22g6az.jpg\",\n    \"text\": \"Breaking news: Trump's consciousness transfer